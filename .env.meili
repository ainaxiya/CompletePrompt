# Meilisearch 环境变量 — 部署前修改！

# Master Key：必须 ≥16 字节，生产环境必填
# 生成方法：openssl rand -hex 24
MEILI_MASTER_KEY=CHANGE_ME_TO_RANDOM_48_CHARS_HEX

# 数据目录（容器内路径，volume 已映射）
MEILI_ENV=production

# 索引快照目录（自动备份）
MEILI_SNAPSHOT_DIR=/meili_data/snapshots

# 日志级别：error / warn / info / debug
MEILI_LOG_LEVEL=info

# 不暴露.env给容器内其他用途
MEILI_NO_ANALYTICS=true

# 索引最大内存占用（按服务器内存调整，如 2GB → 2048）
# MEILI_MAX_INDEXING_MEMORY=2048

# 最大任务并发数（默认 CPU 核数的一半，多核可调）
# MEILI_MAX_TASKING_THREADS=4
