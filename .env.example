# ============ 数据库 ============
# 本地开发（embedded-postgres，npm run db:up 启动）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prompthub"
# 服务器（Docker 版 PG，见 docker-compose.yml，密码改成自己的）
# DATABASE_URL="postgresql://woshizhou:你的密码@127.0.0.1:35432/prompthub"

# ============ 认证 ============
# JWT 签名密钥，必须更换：openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-32-byte-hex"

# ============ Meilisearch ============
# 服务器：https://meili.你的域名.com；本地开发可装 meilisearch.exe 后用 http://127.0.0.1:7700
MEILI_HOST="https://meili.qiukuzi.com"
MEILI_MASTER_KEY="change-me-meili-master-key"

# ============ 站点 ============
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
